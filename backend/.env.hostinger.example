ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/cheesy_crust
MONGODB_DB_NAME=cheesy_crust

JWT_SECRET=replace-with-a-long-random-customer-jwt-secret
ADMIN_JWT_SECRET=replace-with-a-long-random-admin-jwt-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

CORS_ORIGINS=["https://your-frontend-domain.com","https://api.your-domain.com"]
